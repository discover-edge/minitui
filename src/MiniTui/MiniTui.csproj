<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Properties -->
    <PackageId>MiniTui</PackageId>
    <Version>0.6.0</Version>
    <Authors>discover-edge</Authors>
    <Description>A minimal, immediate-mode TUI framework for .NET inspired by ratatui</Description>
    <PackageTags>tui;terminal;console;ui;immediate-mode</PackageTags>
    <RepositoryUrl>https://github.com/discover-edge/minitui</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>
